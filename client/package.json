{
  "name": "esmvaltool",
  "displayName": "ESMValTool",
  "description": "Check, complete, and navigate ESMValTool recipes.",
  "version": "0.1.0",
  "publisher": "ESMValGroup",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ESMValGroup/esmvaltool-language-server"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "esmvaltool.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "ESMValTool"
      }
    ],
    "configurationDefaults": {
      "[yaml]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      }
    },
    "configuration": {
      "title": "ESMValTool",
      "properties": {
        "esmvaltool.languageServer.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python interpreter of the environment where ESMValTool and the language server are installed. If empty, the interpreter selected in the [Python extension](https://marketplace.visualstudio.com/items?itemName=ms-python.python) is used."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "compile": "npm run check-types && npm run bundle",
    "compile-tests": "tsc -p test",
    "watch": "npm run bundle -- --watch",
    "test": "npm run compile && npm run compile-tests && vscode-test",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vscode:prepublish": "npm run check-types && npm run bundle -- --minify",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@vscode/python-extension": "1.0.6",
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.93.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
